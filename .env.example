# Better Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET= # generate with: bunx --bun @better-auth/cli secret

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://postgres:<password>@localhost:5432/orbitv1

# Extra origins allowed to sign in (comma-separated, wildcards ok). Dev: phone on LAN
TRUSTED_ORIGINS=http://192.168.*:3000

# Only these emails can create an account (comma-separated)
ALLOWED_EMAILS=you@example.com

# Reverse proxies in front of the app (IPs/CIDRs, comma-separated). Default fits `tailscale serve`.
# TRUSTED_PROXIES=127.0.0.1,::1

# Whose "today" the app uses
# APP_TIMEZONE=Europe/London
