# Better Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET= # generate with: bunx --bun @better-auth/cli secret

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://postgres:<password>@localhost:5432/orbitv1

# Extra origins allowed to sign in (comma-separated, wildcards ok). Dev: phone on LAN
TRUSTED_ORIGINS=http://192.168.*:3000
